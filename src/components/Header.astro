---
import logo from '../assets/logo.png';
import { negocio } from '../data/negocio';
const enlaces = [
  { href: '#servicios', texto: 'Servicios' },
  { href: '#horario', texto: 'Horario' },
  { href: '#ubicacion', texto: 'Ubicación' },
];
---
<header class="fixed inset-x-0 top-3 z-50 px-3">
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between rounded-full border border-white/10 bg-fondo/70 pr-2 pl-2 shadow-[0_10px_30px_-10px_rgba(0,0,0,.8),inset_0_1px_0_rgba(255,255,255,.06)] backdrop-blur-md">
    <a href="#inicio" class="flex items-center gap-3">
      <img src={logo.src} alt="" width="40" height="40" class="size-10 rounded-full ring-1 ring-white/15" />
      <span class="font-display text-lg font-bold tracking-wide text-white italic">{negocio.nombre}</span>
    </a>
    <ul class="hidden items-center gap-1 text-sm font-semibold text-cromo/80 md:flex">
      {enlaces.map((e) => (
        <li><a href={e.href} class="rounded-full px-4 py-2 transition hover:bg-white/8 hover:text-white">{e.texto}</a></li>
      ))}
    </ul>
    <a href="#ubicacion" class="boton-acento rounded-full px-5 py-2 text-sm font-bold text-white transition">
      Visítanos
    </a>
  </nav>
</header>
