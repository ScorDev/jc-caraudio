---
import { horario } from '../data/negocio';
import Icono from './Icono.astro';

// Tacómetro: 0–24 h repartidas en un arco de 270°
const R = 80;
const CIRC = 2 * Math.PI * R;
const ARCO = CIRC * 0.75;
const angulo = (h: number) => -135 + (h / 24) * 270;
const punto = (h: number, r: number) => {
  const a = (angulo(h) * Math.PI) / 180;
  return { x: 100 + r * Math.sin(a), y: 100 - r * Math.cos(a) };
};
const marcas = Array.from({ length: 25 }, (_, h) => {
  const mayor = h % 6 === 0;
  return { a: punto(h, mayor ? 87 : 90), b: punto(h, 96), mayor, h };
});
---
<section id="horario" class="inclinada relative bg-linear-to-b from-[#16181c] to-[#101215]">
  <div class="rejilla pointer-events-none absolute inset-0 opacity-60"></div>

  <div class="relative mx-auto grid max-w-6xl gap-14 px-5 md:grid-cols-2 md:items-center">
    <div class="revelar">
      <p class="font-display text-sm font-bold uppercase tracking-[.3em] text-acento">// Horario</p>
      <h2 class="mt-3 font-display text-4xl font-bold uppercase italic text-white sm:text-5xl">Te atendemos</h2>
      <p class="mt-4 max-w-md text-cromo/70">Visítanos en nuestro taller y cotiza la instalación que tu auto necesita.</p>

      <div class="mt-8 space-y-3">
        {horario.map((h) => (
          <div data-dias={h.diasNum.join(',')} class="fila marco chaflan" style="--c:12px">
            <div class="interior chaflan flex items-center justify-between gap-4 px-5 py-4">
              <div class="flex items-center gap-3">
                <Icono nombre="reloj" class="size-5 text-acento" />
                <span class="font-display text-base font-bold whitespace-nowrap uppercase italic text-white sm:text-lg">{h.dias}</span>
              </div>
              <span class:list={['text-sm font-semibold whitespace-nowrap sm:text-base', h.abre === null ? 'text-cromo/40' : 'text-cromo']}>{h.texto}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="revelar marco chaflan mx-auto w-full max-w-md" style="--c:32px; --retraso:150ms">
      <div class="interior chaflan p-8">
        <svg viewBox="0 0 200 200" class="w-full" role="img" aria-label="Tacómetro con la hora actual y el horario de hoy">
          <defs>
            <linearGradient id="arco-acento" x1="0" x2="1" y1="1" y2="0">
              <stop offset="0" stop-color="#0b8f3a" />
              <stop offset="1" stop-color="#5cff8f" />
            </linearGradient>
            <radialGradient id="cara" cx=".5" cy=".35" r=".7">
              <stop offset="0" stop-color="#22262c" />
              <stop offset="1" stop-color="#0b0c0e" />
            </radialGradient>
          </defs>
          <circle cx="100" cy="100" r="99" fill="url(#cara)" />
          <circle cx="100" cy="100" r={R} fill="none" stroke="#262a31" stroke-width="12"
            stroke-dasharray={`${ARCO} ${CIRC}`} transform="rotate(135 100 100)" stroke-linecap="round" />
          <circle id="arco-horario" cx="100" cy="100" r={R} fill="none" stroke="url(#arco-acento)" stroke-width="12"
            stroke-dasharray={`0 ${CIRC}`} transform="rotate(135 100 100)"
            style="filter: drop-shadow(0 0 6px rgba(34,214,94,.7)); transition: stroke-dasharray 1.2s ease .3s"
            data-arco={ARCO} data-circ={CIRC} />
          {marcas.map((m) => (
            <line x1={m.a.x} y1={m.a.y} x2={m.b.x} y2={m.b.y}
              stroke={m.mayor ? '#d9dde3' : '#5b616b'} stroke-width={m.mayor ? 2 : 1} />
          ))}
          {marcas.filter((m) => m.mayor && m.h % 24 !== 0).map((m) => {
            const p = punto(m.h, 62);
            return <text x={p.x} y={p.y + 3.5} text-anchor="middle" fill="#9aa0aa" font-size="10" font-family="Chakra Petch" font-weight="700">{m.h}</text>;
          })}
          <g id="aguja">
            <polygon points="97,104 103,104 100.6,32 99.4,32" fill="#ffffff" style="filter: drop-shadow(0 0 4px rgba(255,255,255,.5))" />
          </g>
          <circle cx="100" cy="100" r="9" fill="#22d65e" stroke="#0b0c0e" stroke-width="3" />
          <text id="hora-texto" x="100" y="150" text-anchor="middle" fill="#ffffff" font-size="22" font-family="Chakra Petch" font-weight="700">--:--</text>
          <text x="100" y="164" text-anchor="middle" fill="#7c838e" font-size="7" letter-spacing="2" font-family="Manrope Variable">HORA EN MÉXICO</text>
        </svg>

        <div id="estado" class="invisible mt-4 flex items-center justify-center gap-3 text-sm font-bold">
          <span class="relative flex size-3">
            <span data-pulso class="absolute inline-flex size-full animate-ping rounded-full opacity-60"></span>
            <span data-punto class="relative inline-flex size-3 rounded-full"></span>
          </span>
          <span data-texto></span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { horario } from '../data/negocio';

  // Hora actual en México (independiente de la zona horaria del visitante)
  const partes = new Intl.DateTimeFormat('en-US', {
    timeZone: 'America/Mexico_City', weekday: 'short', hour: 'numeric', minute: 'numeric', hourCycle: 'h23',
  }).formatToParts(new Date());
  const valor = (t: string) => partes.find((p) => p.type === t)?.value ?? '';
  const dia = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(valor('weekday'));
  const horas = Number(valor('hour'));
  const minutos = Number(valor('minute'));
  const hora = horas + minutos / 60;

  const hoy = horario.find((h) => h.diasNum.includes(dia));
  const abre = hoy?.abre ?? null;
  const cierra = hoy?.cierra ?? null;
  const abierto = abre !== null && cierra !== null && hora >= abre && hora < cierra;

  // Tacómetro
  const arco = document.getElementById('arco-horario');
  const aguja = document.getElementById('aguja');
  const horaTexto = document.getElementById('hora-texto');
  if (horaTexto) horaTexto.textContent = `${String(horas).padStart(2, '0')}:${String(minutos).padStart(2, '0')}`;
  requestAnimationFrame(() => requestAnimationFrame(() => {
    if (aguja) aguja.style.transform = `rotate(${-135 + (hora / 24) * 270}deg)`;
    if (arco && abre !== null && cierra !== null) {
      const total = Number(arco.dataset.arco);
      const circ = Number(arco.dataset.circ);
      arco.setAttribute('stroke-dasharray', `${((cierra - abre) / 24) * total} ${circ}`);
      arco.setAttribute('stroke-dashoffset', String(-(abre / 24) * total));
    }
  }));

  // Estado abierto / cerrado
  const estado = document.getElementById('estado');
  if (estado) {
    const color = abierto ? 'bg-acento' : 'bg-red-500';
    estado.querySelector('[data-pulso]')?.classList.add(color);
    estado.querySelector('[data-punto]')?.classList.add(color);
    const texto = estado.querySelector('[data-texto]');
    if (texto) {
      texto.textContent = abierto ? `Abierto ahora · cerramos a las ${cierra! - 12}:00 pm` : 'Cerrado en este momento';
    }
    estado.classList.remove('invisible');
  }

  // Resaltar el día de hoy
  document.querySelectorAll<HTMLElement>('.fila').forEach((fila) => {
    if (fila.dataset.dias?.split(',').map(Number).includes(dia)) {
      fila.style.background = 'linear-gradient(90deg, #5cff8f, #22d65e 40%, rgba(34,214,94,.2))';
      fila.querySelector<HTMLElement>('.interior')!.style.background = 'linear-gradient(90deg, #143823, #121418 70%)';
    }
  });
</script>
