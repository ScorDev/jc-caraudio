---
import { servicios } from '../data/negocio';
import Icono from './Icono.astro';
---
<section id="servicios" class="relative -mt-[3vw] pt-16 pb-24">
  <div class="pointer-events-none absolute top-1/3 left-1/2 h-80 w-[60rem] -translate-x-1/2 rounded-[50%] bg-acento/8 blur-[120px]"></div>

  <div class="relative mx-auto max-w-6xl px-5">
    <div class="revelar mb-14 max-w-2xl">
      <p class="font-display text-sm font-bold uppercase tracking-[.3em] text-acento">// Servicios</p>
      <h2 class="mt-3 font-display text-4xl font-bold uppercase italic text-white sm:text-5xl">Lo que hacemos por tu auto</h2>
      <p class="mt-4 text-cromo/70">Instalaciones profesionales, con atención a cada detalle y el cuidado que tu vehículo merece.</p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {servicios.map((s, i) => (
        <article class="revelar" style={`--retraso:${i * 90}ms`}>
          <div data-inclinar class="marco chaflan group h-full" style="--c:22px">
            <div class="interior chaflan relative overflow-hidden p-7">
              <span class="pointer-events-none absolute -top-3 -right-1 font-display text-8xl font-bold italic text-white/[.045] transition duration-500 group-hover:text-acento/15">
                0{i + 1}
              </span>
              <div class="hex boton-acento mb-6 inline-flex size-14 items-center justify-center text-white">
                <Icono nombre={s.icono} class="size-6" />
              </div>
              <p class="text-xs font-semibold uppercase tracking-widest text-cromo/50">Instalación de</p>
              <h3 class="font-display text-2xl font-bold uppercase italic text-white">{s.titulo}</h3>
              <p class="mt-3 text-sm leading-relaxed text-cromo/70">{s.descripcion}</p>
              <ul class="mt-5 space-y-2 text-sm text-cromo/85">
                {s.puntos.map((p) => (
                  <li class="flex items-center gap-2.5">
                    <span class="h-1.5 w-3 -skew-x-[20deg] bg-acento"></span>{p}
                  </li>
                ))}
              </ul>
              <div class="mt-6 h-1 w-10 -skew-x-[30deg] bg-linear-to-r from-acento to-acento-claro transition-all duration-500 group-hover:w-full"></div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
