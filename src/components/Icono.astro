---
import type { Icono } from '../data/negocio';
interface Props {
  nombre: Icono | 'reloj' | 'pin' | 'tel' | 'flecha';
  class?: string;
}
const { nombre, class: clase = 'size-6' } = Astro.props;
---
<svg class={clase} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {nombre === 'audio' && (<><rect x="5" y="2" width="14" height="20" rx="2" /><circle cx="12" cy="14" r="4" /><circle cx="12" cy="14" r="1" /><circle cx="12" cy="6" r="1.2" /></>)}
  {nombre === 'alarma' && (<><path d="M12 2 4 5v6c0 5 3.4 9.3 8 11 4.6-1.7 8-6 8-11V5l-8-3Z" /><path d="m9 12 2 2 4-4" /></>)}
  {(nombre === 'gps' || nombre === 'pin') && (<><path d="M12 22s-7-6.2-7-12a7 7 0 1 1 14 0c0 5.8-7 12-7 12Z" /><circle cx="12" cy="10" r="2.5" /></>)}
  {nombre === 'led' && (<><path d="M9 18h6M10 22h4" /><path d="M12 2a7 7 0 0 0-4 12.7V16h8v-1.3A7 7 0 0 0 12 2Z" /></>)}
  {nombre === 'reloj' && (<><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>)}
  {nombre === 'tel' && <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" />}
  {nombre === 'flecha' && <path d="M5 12h14M13 6l6 6-6 6" />}
</svg>
