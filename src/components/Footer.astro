---
import { negocio } from '../data/negocio';
const redes = [
  { nombre: 'Facebook', url: negocio.facebook },
  { nombre: 'Instagram', url: negocio.instagram },
].filter((r) => r.url);
const anio = new Date().getFullYear();
---
<footer class="border-t border-white/5 py-10">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 px-5 text-sm text-cromo/60 md:flex-row">
    <div class="flex items-center gap-3">
      <img src="/logo.png" alt="" width="32" height="32" class="size-8 rounded-full" />
      <span>© {anio} {negocio.nombre}</span>
    </div>
    {redes.length > 0 && (
      <ul class="flex gap-6 font-semibold">
        {redes.map((r) => <li><a href={r.url} target="_blank" rel="noopener" class="transition hover:text-white">{r.nombre}</a></li>)}
      </ul>
    )}
  </div>
</footer>

{negocio.whatsapp && (
  <a
    href={`https://wa.me/${negocio.whatsapp}?text=${encodeURIComponent(`Hola ${negocio.nombre}, quiero información sobre sus servicios.`)}`}
    target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp"
    class="fixed right-5 bottom-5 z-50 inline-flex size-14 items-center justify-center rounded-full bg-[#25d366] text-white shadow-lg transition hover:scale-110"
  >
    <svg viewBox="0 0 24 24" class="size-7" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5 2.5 1 3 .8 3.6.7.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.2-.3-.3-.6-.4ZM12 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.8 9.8 0 1 1 12 21.8ZM12 0a12 12 0 0 0-10.3 18L0 24l6.2-1.6A12 12 0 1 0 12 0Z"/></svg>
  </a>
)}
