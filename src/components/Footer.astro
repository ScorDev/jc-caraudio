---
import logo from '../assets/logo.png';
import { negocio, whatsappUrl } from '../data/negocio';
import Icono from './Icono.astro';
const redes = [
  { nombre: 'Facebook', url: negocio.facebook },
  { nombre: 'Instagram', url: negocio.instagram },
].filter((r) => r.url);
const anio = new Date().getFullYear();
---
<footer class="border-t border-white/5 py-10">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 px-5 text-sm text-cromo/60 md:flex-row">
    <div class="flex items-center gap-3">
      <img src={logo.src} alt="" width="32" height="32" class="size-8 rounded-full" />
      <span>© {anio} {negocio.nombre}</span>
    </div>
    {redes.length > 0 && (
      <ul class="flex gap-6 font-semibold">
        {redes.map((r) => <li><a href={r.url} target="_blank" rel="noopener" class="transition hover:text-white">{r.nombre}</a></li>)}
      </ul>
    )}
  </div>
</footer>

{whatsappUrl && (
  <a
    href={whatsappUrl}
    target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp"
    class="group fixed right-4 bottom-4 z-50 flex items-center gap-3 sm:right-6 sm:bottom-6"
  >
    <span class="hidden rounded-full border border-white/10 bg-fondo/85 px-4 py-2 text-sm font-bold text-white shadow-lg backdrop-blur transition group-hover:border-[#25d366]/60 sm:block">
      ¿Cotizamos? Escríbenos
    </span>
    <span class="relative inline-flex size-14 items-center justify-center rounded-full bg-[#25d366] text-white shadow-[0_8px_24px_-6px_rgba(37,211,102,.7)] transition group-hover:scale-110">
      <span class="absolute inset-0 animate-ping rounded-full bg-[#25d366] opacity-30 motion-reduce:hidden"></span>
      <Icono nombre="whatsapp" class="relative size-7" />
    </span>
  </a>
)}
