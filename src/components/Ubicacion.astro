---
import { negocio, mapa } from '../data/negocio';
import Icono from './Icono.astro';
---
<section id="ubicacion" class="relative py-24">
  <div class="pointer-events-none absolute right-0 bottom-0 size-[30rem] rounded-full bg-acento/10 blur-[130px]"></div>

  <div class="relative mx-auto max-w-6xl px-5">
    <div class="revelar mb-12 max-w-2xl">
      <p class="font-display text-sm font-bold uppercase tracking-[.3em] text-acento">// Ubicación</p>
      <h2 class="mt-3 font-display text-4xl font-bold uppercase italic text-white sm:text-5xl">Encuéntranos</h2>
    </div>

    <div class="revelar marco chaflan shadow-2xl" style="--c:36px">
      <div class="interior chaflan grid lg:grid-cols-[1fr_1.6fr]">
        <div class="relative flex flex-col justify-between gap-8 overflow-hidden p-8 lg:p-10">
          <svg class="pointer-events-none absolute -bottom-10 -left-10 size-56 text-white/[.03]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 22s-7-6.2-7-12a7 7 0 1 1 14 0c0 5.8-7 12-7 12Z" />
          </svg>
          <div class="relative">
            <div class="hex boton-acento mb-5 inline-flex size-14 items-center justify-center text-white">
              <Icono nombre="pin" />
            </div>
            <h3 class="font-display text-2xl font-bold uppercase italic text-white">{negocio.nombre}</h3>
            <address class="mt-3 not-italic leading-relaxed text-cromo/75">{negocio.direccion}</address>
          </div>
          <div class="relative flex flex-col gap-3">
            <a href={mapa.comoLlegar} target="_blank" rel="noopener" class="corte boton-acento group inline-flex items-center justify-center gap-2 py-3.5 font-bold text-white transition">
              Cómo llegar <Icono nombre="flecha" class="size-5 transition group-hover:translate-x-1" />
            </a>
            {negocio.telefono && (
              <a href={`tel:${negocio.telefono.replace(/\s/g, '')}`} class="corte inline-flex items-center justify-center gap-2 bg-white/8 py-3.5 font-bold text-white transition hover:bg-white/15">
                <Icono nombre="tel" class="size-5" /> {negocio.telefono}
              </a>
            )}
          </div>
        </div>
        <div class="relative min-h-80 lg:min-h-[440px]">
          <iframe
            src={mapa.embed}
            title={`Mapa de ubicación de ${negocio.nombre}`}
            class="absolute inset-0 size-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
          <div class="pointer-events-none absolute inset-y-0 left-0 w-10 bg-linear-to-r from-[#15171b] to-transparent max-lg:hidden"></div>
        </div>
      </div>
    </div>
  </div>
</section>
