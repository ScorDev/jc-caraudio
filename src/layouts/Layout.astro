---
import '../styles/global.css';
import { negocio } from '../data/negocio';
import logo from '../assets/logo.png';

const logoAbsoluto = new URL(logo.src, Astro.site).href;

const titulo = `${negocio.nombre} | Car Audio, Alarmas, GPS y LED en Ojo de Agua`;
const descripcion = `Instalación de car audio, alarmas, GPS y luces LED en Ojo de Agua, Edo. Méx. ${negocio.direccion}`;

const datosEstructurados = {
  '@context': 'https://schema.org',
  '@type': 'AutoPartsStore',
  name: negocio.nombre,
  image: logoAbsoluto,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Blvrd Ojo de Agua Manzana 001, Los Arcos',
    addressLocality: 'Ojo de Agua',
    postalCode: '55770',
    addressRegion: 'Méx.',
    addressCountry: 'MX',
  },
  ...(negocio.telefono && { telephone: negocio.telefono }),
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '10:00', closes: '19:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '10:00', closes: '17:00' },
  ],
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={logoAbsoluto} />
    <meta name="theme-color" content="#0b0c0e" />
    <link rel="icon" type="image/png" href={logo.src} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(datosEstructurados)} />
  </head>
  <body class="font-sans antialiased">
    <slot />
    <script>
      const io = new IntersectionObserver((entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            io.unobserve(e.target);
          }
        }
      }, { threshold: 0.15 });
      document.querySelectorAll('.revelar').forEach((el) => io.observe(el));

      // Inclinación 3D de tarjetas (solo con mouse y sin "reducir movimiento")
      if (matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
        document.querySelectorAll<HTMLElement>('[data-inclinar]').forEach((el) => {
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width;
            const y = (e.clientY - r.top) / r.height;
            el.style.transform = `perspective(900px) rotateX(${(0.5 - y) * 12}deg) rotateY(${(x - 0.5) * 14}deg) scale(1.02)`;
            el.style.setProperty('--mx', `${x * 100}%`);
            el.style.setProperty('--my', `${y * 100}%`);
          });
          el.addEventListener('pointerleave', () => {
            el.style.transform = '';
            el.style.removeProperty('--mx');
            el.style.removeProperty('--my');
          });
        });
      }
    </script>
  </body>
</html>
